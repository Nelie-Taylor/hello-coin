# Comma-separated symbols the technical/liquidation/decision services watch.
# Defaults to BTCUSDT if unset.
EXCHANGE_WATCH_SYMBOLS=BTCUSDT

# Hyperdash API token (hyperdash.info) and the coins whose whale position skew the
# dashboard tracks (charts, coin position tables, Telegram alerts).
HYPERDASH_API_TOKEN=
HYPERDASH_WATCH_COINS=LINK,SOL,SUI,NEAR,HYPE
HYPERDASH_DELTA_TIMEFRAME=FIFTEEN_MINUTES
HYPERDASH_MIN_DELTA_USD=50000
HYPERDASH_MIN_POSITION_USD=50000

# Anthropic API key (console.anthropic.com) for the AI decision engine. Every call costs money —
# there's no free tier for this one. ANTHROPIC_MODEL defaults to claude-sonnet-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Coinglass API key (coinglass.com, paid — required for the liquidation-heatmap signal).
# LIQUIDATION_PROXIMITY_PCT controls how far (as a fraction of price) a liquidation cluster
# can be from the current price and still count toward liquidation_score. The response shape
# is not first-party-confirmed — see
# docs/superpowers/specs/2026-08-22-liquidation-heatmap-design.md.
COINGLASS_API_KEY=
LIQUIDATION_PROXIMITY_PCT=0.10
LIQUIDATION_POLL_INTERVAL_SECONDS=900

# Telegram bot token (create one via @BotFather on Telegram) and the chat ID that should receive
# position skew LONG/SHORT dominance alerts. Both must be set or no alerts are sent — this is
# optional, not required for the dashboard to run.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Host/port the web dashboard binds to. The default (0.0.0.0:8080) works both for
# `uv run hello-coin dashboard` on the host and for the Docker container (0.0.0.0 so the
# container's published port is reachable from outside it).
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
